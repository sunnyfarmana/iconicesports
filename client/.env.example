# ICONIC ESPORTS Client Environment Configuration
# For local development with Vite proxy, leave empty or unset.
# For distributed production (e.g., Vercel frontend + Render backend):

# Backend Express API URL
VITE_API_URL="/api"

# WebSocket Server URL (Leave empty for same-origin proxy)
VITE_SOCKET_URL=""

# Optional Supabase Client Configuration (Public Anon Key ONLY - NEVER Service Role)
# VITE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
