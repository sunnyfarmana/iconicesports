# Supabase PostgreSQL Database (Transaction Mode Pooler - Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Database (Session Mode Direct Pooler - Port 5432 for Prisma migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT Secret & Server Configuration
JWT_SECRET="your-256-bit-jwt-secret-key-change-in-production"
PORT=5000
NODE_ENV="production"
